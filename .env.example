# Supabase (Project settings → API). The service role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API keys)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=arawali007@gmail.com
# Must be on a domain verified in Resend. Until arawalitextile.com is verified, use:
#   ENQUIRY_FROM_EMAIL="Arawali Textile <onboarding@resend.dev>"
# (Resend's test sender only delivers to your own Resend account address, so buyer auto-replies won't arrive until the domain is verified.)
ENQUIRY_FROM_EMAIL=enquiries@arawalitextile.com

NEXT_PUBLIC_WHATSAPP_NUMBER=917877945556
NEXT_PUBLIC_SITE_URL=https://arawalitextile.com

# Gemini (aistudio.google.com → Get API key) for the website chat assistant. Free tier is enough to start.
GEMINI_API_KEY=
# Optional: preferred model (default gemini-3.5-flash-lite; gemini-3.8-flash is the fallback)
GEMINI_MODEL=
