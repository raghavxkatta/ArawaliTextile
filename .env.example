# Supabase (Project settings → API). The service role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API keys)

# Must be on a domain verified in Resend. Until arawalitextile.com is verified, use:
#   ENQUIRY_FROM_EMAIL="Arawali Textile <onboarding@resend.dev>"
# (Resend's test sender only delivers to your own Resend account address, so buyer auto-replies won't arrive until the domain is verified.)
